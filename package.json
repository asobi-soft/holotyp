{
    "name": "holotyp-preview-viewer",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite crates/holotyp-preview-viewer",
        "build": "run-s type-check \"build-only {@}\" --",
        "preview": "vite preview crates/holotyp-preview-viewer",
        "build-only": "vite build crates/holotyp-preview-viewer",
        "type-check": "vue-tsc --build",
        "test:e2e": "playwright test",
        "lint": "eslint crates/holotyp-preview-viewer packages/preview-protocol --fix --cache",
        "format": "oxfmt crates/holotyp-preview-viewer packages/preview-protocol"
    },
    "dependencies": {
        "@asobisoft/holotyp-preview-protocol": "workspace:*",
        "vue": "^3.5.42"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@playwright/test": "1.51.1",
        "@tsconfig/node24": "^24.0.5",
        "@types/node": "^24.13.4",
        "@vitejs/plugin-vue": "^6.0.8",
        "@vue/eslint-config-typescript": "^14.9.0",
        "@vue/tsconfig": "^0.9.1",
        "eslint": "^10.14.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-oxfmt": "^0.30.0",
        "eslint-plugin-vue": "^10.12.0",
        "globals": "^17.13.0",
        "jiti": "^2.7.0",
        "npm-run-all2": "^9.0.3",
        "oxfmt": "^0.75.0",
        "typescript": "catalog:",
        "vite": "^8.2.2",
        "vite-plugin-vue-devtools": "^8.2.1",
        "vue-eslint-parser": "^10.4.1",
        "vue-tsc": "^3.3.11"
    },
    "engines": {
        "node": "^22.18.0 || >=24.12.0"
    }
}

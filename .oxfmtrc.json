{
    "$schema": "./node_modules/oxfmt/configuration_schema.json",
    "semi": false,
    "tabWidth": 2,
    "printWidth": 90,
    "jsdoc": {
        "lineWrappingStyle": "greedy",
        "commentLineStrategy": "multiline"
    },
    "overrides": [
        {
            "files": ["**/*.json", "**/*.jsonc"],
            "options": {
                "tabWidth": 4
            }
        }
    ]
}
